    "88",
    "89",
    "90",
    "91"
   ]
  },
  {
   "id": "zoku-gunsho-eikyo9-sumiyoshi-hyakushu-0011",
   "pid": "nao-733558",
   "pages": [
    11
   ],
   "text": "山里のかけ樋の竹の夜はゝもにねふりをこます水の音かな山家嵐悲貴なれぬれは夢も見へけりいほしむ画のあらしはいつとなけれと田家雨義雅かるとみし稲葉の雲分はれぬれと雨ふり壱をふ小田のより昼旅行公保日数のみたちかさね行旅ころ母いくへかこゑしみねのしみむ定親旅宿いさこそぬれませりけりけり旅衣袖のみなとの浪のまくらに雅親海毘坐える〳〵とかその入海あかす見て心そかとふあまのはし立寄松祝宗縄松のみか君を千は聲とすみよしの神母さこそこそと契りたくらめ寄日祝新堂かくあまつみそらにめくるものへ等きりもしらす世を照すらし此百首都哥永享九年三月十五日住吉之御社奉納之畢",
   "poems": [
    "92",
    "93",
    "94",
    "95",
    "96",
    "97",
    "98",
    "99"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "一も夜はわつかに暮る日数をもまたてや春のたちかへる遅葬",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "同十二年十二月八日歳中立春"
  },
  {
   "seq": "2",
   "text": "春といへは霞の衣たちかさねきを山松もみとりそふとし",
   "kana": "",
   "speaker": "義へ",
   "page": 1,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山霞",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "時しらぬふしのたかねを春の色にすそのはかりは雪までなる",
   "kana": "",
   "speaker": "御詠",
   "page": 1,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雪",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "春はまた朝風さむき雪の中にこほはぬものは鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "朝鶯",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "もはいつるあさす水のふるねせり氷のひまをたつてそつむ",
   "kana": "",
   "speaker": "公保",
   "page": 2,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "沢若菜",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "春そとは名にのみたちて風さむし霞はいつら雪のやまの端",
   "kana": "",
   "speaker": "実雅",
   "page": 2,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "余寒",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "木の下に行てとふへき梅かゝをさそひし風の屋とりしらはや",
   "kana": "",
   "speaker": "特之",
   "page": 2,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "梅薫風",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "なひきよる道のゆくての青榊は袖もみとりにはる風そふく",
   "kana": "",
   "speaker": "定親",
   "page": 2,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "行路柳",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "一軒はにてかす世とはかりなをみへて空にしられぬ春の雨かな",
   "kana": "",
   "speaker": "親世",
   "page": 2,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雨",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "白雪のふはすくなき若草や我のか夜もて野辺をそむらん",
   "kana": "",
   "speaker": "実豊",
   "page": 2,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "若草",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "夜もすから霞める月の山のはに鐘のこゑさへをほろなりけり",
   "kana": "",
   "speaker": "瑞禅",
   "page": 2,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春月",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "いかなれは月にめてこしこゝろもて都の花に雁の遊く羅耳",
   "kana": "",
   "speaker": "宗継",
   "page": 2,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "帰嶋",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "それとみし高ねの雲のたへきよりかつさて先のいろそまかはぬ",
   "kana": "",
   "speaker": "資任",
   "page": 2,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "人つてのいつくはあれとさくら花見類に勝れる迄やなか焼",
   "kana": "",
   "speaker": "持春",
   "page": 2,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "見花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "山もりに梢のこくらそれならてかさすこゝろの",
   "kana": "",
   "speaker": "雅親",
   "page": 3,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "翫花",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "おしむにももまらめ心花のならひとはをもひしりても猶しこふらん",
   "kana": "",
   "speaker": "持鹿",
   "page": 3,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "惜花",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "吹風のよそにさそはて分る花や木下ふるき雪と見ゆらむ",
   "kana": "",
   "speaker": "実勝",
   "page": 3,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "藤花",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "山吹のまかきのいろに春くれて残る日かすをへたてやはする",
   "kana": "",
   "speaker": "特堅",
   "page": 3,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "難歎は",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "高砂の松の木片衛に咲しより尾上をこゆる藤なみのはな",
   "kana": "",
   "speaker": "親世",
   "page": 3,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松上藤",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "おしみきていく日もあらぬ春のものあわれに霞むけ暮の空",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "桜吹風にも花はのこる世にけさよりきぬるなつころほにな",
   "kana": "",
   "speaker": "義雅",
   "page": 3,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏十首首夏",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "宵のまはまた初音をも忍ふやとふけてまたるゝほてゝきすかな",
   "kana": "",
   "speaker": "教親",
   "page": 3,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "待郭公",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "行かたの山ちにゝらしほと寄す返りてになく明ほのこそら",
   "kana": "",
   "speaker": "義は",
   "page": 3,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "聞部公",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "さみたれにこりし水もすみ吉やもしろいふにてなへ取なり",
   "kana": "",
   "speaker": "宗継",
   "page": 4,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早苗",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "こつもれて谷の下水おとふるみ雲間にひゝく五月雨のころ",
   "kana": "",
   "speaker": "実雅",
   "page": 4,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "亥五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "吹わくる風のなとさへみえぬまて夏野の夢や茂り抱くらん",
   "kana": "",
   "speaker": "資任",
   "page": 4,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏草",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "御ゑのほる影も親し夏しらぬうたの妙宝の嶺場の月",
   "kana": "",
   "speaker": "雅世",
   "page": 4,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏月",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "池水のいひ出かたきおもひとや身をのみこかす蛍なるらん",
   "kana": "",
   "speaker": "雅親",
   "page": 4,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水辺蛍",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "よそに見るほともなくてや此風の雲吹をくる夕立の雨",
   "kana": "",
   "speaker": "公保",
   "page": 4,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "御祓する幣もとりあへすくる秋のよそせ涼しきかもの川浪",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "六月抜",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "秋きぬとつけの枕を教妙の神にすゝしき風の音かな",
   "kana": "",
   "speaker": "実雅",
   "page": 4,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早秋",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "またよひの星合の空の月かけをふけても残す庭のともし大",
   "kana": "",
   "speaker": "義一",
   "page": 4,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "乞巧尊",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "秋風に露も夢をもむすはねはかへしそつらき庭の萩原",
   "kana": "",
   "speaker": "宗継",
   "page": 4,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩風",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "ゆふ霞のむすふと見ゆるいて萩の吹とし風に尤そ乱るゝ",
   "kana": "",
   "speaker": "実量",
   "page": 5,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩風",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "老ならぬ人にとそやたか身にもをなしつらさか秋の夕くれ",
   "kana": "",
   "speaker": "道へ",
   "page": 5,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋夕",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "風渡る和さまのいな葉一かたになひくをみなは雁も先にけり",
   "kana": "",
   "speaker": "雅世",
   "page": 5,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初雁",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "やゝさむき秋の此風吹ぬらし鳥羽田のいな葉色かはるなり",
   "kana": "",
   "speaker": "雅親",
   "page": 5,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋田",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "をのれのみ立田の山になく鹿の夜半にや独宴を恋らん",
   "kana": "",
   "speaker": "公保リ",
   "page": 5,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜鹿",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "今はかやとひ来る人もあらしとや暁かなる松むしのこゑ",
   "kana": "",
   "speaker": "御詠",
   "page": 5,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁虫",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "山のはに夕井る雲をさそひつる風こそ月のひけりとはなれ",
   "kana": "",
   "speaker": "持之",
   "page": 5,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "正月",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "から凌や松の一木もかつみえて話にいきよふ秋のよの月",
   "kana": "",
   "speaker": "持康",
   "page": 5,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "湖月",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "自影のやさかる野への秋の寄あらくは分し萩の下みな",
   "kana": "",
   "speaker": "持春",
   "page": 5,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野自",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "夜ふねこく淀のわたりの末見へて月かけきよき浪の上ろな",
   "kana": "",
   "speaker": "定親",
   "page": 5,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "渡月",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "自屋とり庭のよもきに露をちて霧のまかきもあるゝ秋風",
   "kana": "",
   "speaker": "照貴",
   "page": 6,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "庭",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "逢坂やせきの清水の影もみす木下くらき秋のゆふきり",
   "kana": "",
   "speaker": "道へ",
   "page": 6,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関霧",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "秋ふかき夜寒はたれもしる物を音にたてともうつ衣かな",
   "kana": "",
   "speaker": "雅世",
   "page": 6,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "聞摂衣",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "長月屋候ふの日数も九重の雲井にめくる菊のさよつき",
   "kana": "",
   "speaker": "宗継",
   "page": 6,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "重陽宴",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "木陰まてしくるゝ色は見るてなくに雫やも里の下葉そひらん",
   "kana": "",
   "speaker": "義は",
   "page": 6,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "一谷川にうつるもちるも紅葉はのうそふは峯の梢なりけり",
   "kana": "",
   "speaker": "瑞禅",
   "page": 6,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "川紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "さま〳〵の秋のなこ利もけふまてとゆふへうかうてちををしむ哉",
   "kana": "",
   "speaker": "貞国",
   "page": 6,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "九月昼",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "晴くもるさためなけれと冬これはかならすやかてふる時雨哉",
   "kana": "",
   "speaker": "特之",
   "page": 6,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初冬時雨特之",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "霜さゆる野辺の尾花のかれしをれまねくもよはき袖もみへつゝ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒草",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "しはし又しくれぬひまも真木の屋にね覚さひしくちら木葉かな",
   "kana": "",
   "speaker": "定親",
   "page": 7,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "たはひ来ていく度かけも時雨うらんあらし吹夜の世に雲の月",
   "kana": "",
   "speaker": "義ゝ",
   "page": 7,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬月",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "すみよしの神の心も夜屋をむき雪もひとへの薄きころもに",
   "kana": "",
   "speaker": "道へ",
   "page": 7,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浅雪",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "今朝も猶雪はつもりのあまの袖はこひもあへぬ浦風そふく",
   "kana": "",
   "speaker": "雅世",
   "page": 7,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "積雪",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "庭の池の鴨の春みかや氷がらんとけてねぬ夜は声をはりなり",
   "kana": "",
   "speaker": "持堅",
   "page": 7,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "池水",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "山あゐのをみの袂屋しるからしとよのあかりの雪の雪の光りに",
   "kana": "",
   "speaker": "公保",
   "page": 7,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "豊明節会",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "なるみかこ夕瀬こゆるほとそとやかへ野をかけてちとり鳴らん",
   "kana": "",
   "speaker": "鳥実雅",
   "page": 7,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "潟千鳥潟千",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "春秋にめてこし月のひかりのみつもり天年の暮となりぬる",
   "kana": "",
   "speaker": "実量",
   "page": 7,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "涙のみ晴ぬうき身は自夜よし夜よしこつけはことのはもなし",
   "kana": "",
   "speaker": "公保",
   "page": 7,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄月恋",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "きへかへりしたふとをしれ衣〳〵のな上り今はの峯の横雲",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄雲恋",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "うき中のなかめにしけき玉水も袖のしつくもたへぬころ哉",
   "kana": "",
   "speaker": "宗継",
   "page": 8,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄雨恋",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "いまはうき身をから風のたよりにもさすかに彼のよるへをそまつ",
   "kana": "",
   "speaker": "定親",
   "page": 8,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄風愁",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "くらへ見んおもひのけふりいかに聞ん室のやしまもこその夕くれ",
   "kana": "",
   "speaker": "雅世",
   "page": 8,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄烟恋",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "うき人のこゝろのせきはゆるさねと名をこそたのめあふこかの山",
   "kana": "",
   "speaker": "義一",
   "page": 8,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄関恋",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "ことくそこに人にはいはぬをもひゆへおつる海もをもなしの滝",
   "kana": "",
   "speaker": "持之",
   "page": 8,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄瀧恋",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "いつまてかつれなき色に年わへんをふの堂原なをたのめとも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄原恋",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "契りこそをこへの橋の名にふりて又わふみ見ぬ中にかけけれ",
   "kana": "",
   "speaker": "実雅",
   "page": 8,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄橋恋",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "一たのまめや涙の袖のみなとふねよるへもしらぬ中のちきかは",
   "kana": "",
   "speaker": "持康",
   "page": 8,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄湊恋",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "逢事はしらぬふせやのはゝ末々のなにその原はありとみゆらん",
   "kana": "",
   "speaker": "持堅",
   "page": 8,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄木恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "うちとけていつかはわねんさね葛くるよをしらぬ人を待弟を",
   "kana": "",
   "speaker": "雅親",
   "page": 8,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄草恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "人はみし御天もおもひも止鳥のへたつるまゝ忠身を如何虎ん",
   "kana": "",
   "speaker": "持春",
   "page": 9,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鳥恋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "駕もかく彦井の床の露けとは少かひとりゐの袖にしらるゝ",
   "kana": "",
   "speaker": "義雅",
   "page": 9,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄獣恋義雅寄獣恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "かき中のちきりは身をも秋土の音にこゝしもかひやなか覧",
   "kana": "",
   "speaker": "雑親",
   "page": 9,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄虫恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "〽せきあへぬ泪の玉も神のうへにくたけてをもふ心とをしれ",
   "kana": "",
   "speaker": "実勝",
   "page": 9,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄玉恋",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "うつしそく願ハなけれツミそこひに猶も思ひのますかみ哉",
   "kana": "",
   "speaker": "教親",
   "page": 9,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鏡恋",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "もうすても誰には知んひとりぬか我手枕にあまるなみたを",
   "kana": "",
   "speaker": "資任",
   "page": 9,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄枕恋",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "いたつらにうすき契りはかつせみのわぬけのころもきてもかひなし",
   "kana": "",
   "speaker": "雅世",
   "page": 9,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄衣恋",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "をしてなをわれこそたのめ梓弓人は心もひかぬちきりを",
   "kana": "",
   "speaker": "賢豊",
   "page": 9,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄弓恋",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "鳴そむる夕つけ鳥の尾上より影さしのほるありあけのゝ",
   "kana": "",
   "speaker": "雅世",
   "page": 9,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暁鶏",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "いたつらにかくさぬ窓のともしまそまた宵なから新かすかなる",
   "kana": "",
   "speaker": "実雅",
   "page": 10,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夜燈",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "一三笠山君をさしても万代もかはふるこゑは嶺のまつ風",
   "kana": "",
   "speaker": "道は",
   "page": 10,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "峯松",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "代々をへて猶わかえ行此君にあひかぬはなし里濃これ升",
   "kana": "",
   "speaker": "資任",
   "page": 10,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "里竹",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "淡路かたゑしまり磯のゆふなみやまする岩尾に音くたくらん",
   "kana": "",
   "speaker": "瑞禅",
   "page": 10,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "磯巌",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "松嶋や松嶋や松平代をかたは千代をかたらふこつのもろこゑ",
   "kana": "",
   "speaker": "持康",
   "page": 10,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "嶋鶴",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "し井てなをいかなる霧かほかのへのさゝの葉そよき嵐吹なり",
   "kana": "",
   "speaker": "実豊",
   "page": 10,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "岡篠",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "あしの葉のみたれぬ御代を守るにし難波記近きすみ吉の神",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "江芦",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "分てなを海土もこくそや住吉のきしに露くる沖の釣ふね",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦舟",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "しからきの槙の杣山たつ民裳なけきなき世を今あふくらん",
   "kana": "",
   "speaker": "特之",
   "page": 10,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松山",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "住の江しきしの岩根の松かえにをなしみそり黒苔やすむこん",
   "kana": "",
   "speaker": "実勝",
   "page": 10,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松山",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "山里のかけ樋の竹の夜はゝもにねふりをこます水の音かな",
   "kana": "",
   "speaker": "特堅",
   "page": 11,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家水",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "なれぬれは夢も見へけりいほしむ画のあらしはいつとなけれと",
   "kana": "",
   "speaker": "悲貴",
   "page": 11,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家嵐",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "かるとみし稲葉の雲分はれぬれと雨ふり壱をふ小田のより昼",
   "kana": "",
   "speaker": "義雅",
   "page": 11,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家雨",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "日数のみたちかさね行旅ころ母いくへかこゑしみねのしみむ",
   "kana": "",
   "speaker": "公保",
   "page": 11,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅行",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "いさこそぬれませりけりけり旅衣袖のみなとの浪のまくらに",
   "kana": "",
   "speaker": "定親",
   "page": 11,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅宿",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "える〳〵とかその入海あかす見て心そかとふあまのはし立",
   "kana": "",
   "speaker": "雅親",
   "page": 11,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海毘坐",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "松のみか君を千は聲とすみよしの神母さこそこそと契りたくらめ",
   "kana": "",
   "speaker": "宗縄",
   "page": 11,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄松祝",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "新堂かくあまつみそらにめくるものへ等きりもしらす世を照すらし",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733558",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄日祝",
   "kotobagaki": ""
  }
 ],
